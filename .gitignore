# Transport prototype official evidence is published as one immutable release
# asset instead of being stored in normal Git history. Keep only the compact
# decision records and the release checksum in the repository.
artifacts/transport-prototype/official/**
!artifacts/transport-prototype/official/README.md
!artifacts/transport-prototype/official/COMPLETION.md
!artifacts/transport-prototype/official/ENVIRONMENT-EXCEPTION.md
!artifacts/transport-prototype/official/decision-memo.md
!artifacts/transport-prototype/official/final-report.json
!artifacts/transport-prototype/official/final-report.md
!artifacts/transport-prototype/official/RELEASE-ASSET.sha256

# Locally generated release bundles are uploaded separately.
artifacts/transport-prototype/release/

# Locally generated OCI release archives and checksum sidecars.
/dist/

# Local-only notes; never published.
/docs/local/

# AI assistant working files (Claude Code, Codex). These are personal to
# whoever ran the tool and are not part of the source of record.
CLAUDE.md
CLAUDE.local.md
.claude/
AGENT.md
AGENT.local.md
AGENTS.md
AGENTS.local.md
.agent/
.agents/
.codex/

# Playwright dependencies and local browser-test evidence.
/node_modules/
/playwright-report/
/test-results/

# Desktop widget dependencies and Rust build output.
/desktop/node_modules/
/desktop/playwright-report/
/desktop/test-results/
/desktop/src-tauri/gen/
/desktop/src-tauri/target/
